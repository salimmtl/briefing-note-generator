                  "item/brn_details": "Final PDF filed and sent to @{replace(if(and(equals(body('Get_Request')?['brn_deliverymode'], 743800000), not(empty(coalesce(body('Get_Request')?['brn_recipientemail'], '')))), concat(body('Get_Request')?['brn_requesteremail'], ';', body('Get_Request')?['brn_recipientemail']), body('Get_Request')?['brn_requesteremail']), ';', ', ')}.",
                  "item/brn_completedon": "@utcNow()",
                  "item/brn_durationseconds": "@div(sub(ticks(utcNow()), ticks(variables('startTime'))), 10000000)"
