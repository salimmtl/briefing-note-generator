         "Notify_Review": {
          "type": "Scope",
          "actions": {
           "Email_Reviewer": {
            "type": "OpenApiConnection",
            "inputs": {
             "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2"
             },
             "parameters": {
              "emailMessage/To": "@coalesce(body('Get_Request')?['brn_revieweremail'], body('Get_Profile')?['brn_defaultrevieweremail'], body('Get_Request')?['brn_requesteremail'])",
              "emailMessage/Subject": "[@{body('Get_Request')?['brn_requestnumber']}] Draft ready for review: @{body('Get_Request')?['brn_notetitle']}",
              "emailMessage/Body": "<p>A draft briefing note is ready for your review.</p><p><b>@{replace(replace(replace(coalesce(body('Get_Request')?['brn_notetitle'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</b><br>For: @{coalesce(body('Get_Request')?['brn_recipientname'], '')} @{coalesce(body('Get_Request')?['brn_recipienttitle'], '')}<br>Requested by: @{coalesce(body('Get_Request')?['brn_requestername'], body('Get_Request')?['brn_requesteremail'])}<br>Classification: @{body('Get_Request')?['brn_classification@OData.Community.Display.V1.FormattedValue']} &middot; Confidence: @{coalesce(body('Get_Request')?['brn_confidence@OData.Community.Display.V1.FormattedValue'], 'n/a')} &middot; Draft v@{body('Get_Request')?['brn_draftversion']}</p><h3>Key message</h3><p>@{substring(replace(replace(replace(concat(decodeUriComponent('%0A'), replace(replace(replace(coalesce(body('Get_Request')?['brn_keymessage'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')), decodeUriComponent('%0A'), '<br>'), '<br>- ', '<br>&bull;&nbsp;'), '<br><br>&bull;', '<br>&bull;'), 4)}</p><h3>Verification notes</h3><p>@{substring(replace(replace(replace(concat(decodeUriComponent('%0A'), replace(replace(replace(coalesce(body('Get_Request')?['brn_verificationnotes'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')), decodeUriComponent('%0A'), '<br>'), '<br>- ', '<br>&bull;&nbsp;'), '<br><br>&bull;', '<br>&bull;'), 4)}</p><p>Edit the sections, then <b>Approve</b> or <b>Request revision</b> in Briefing Studio (or ask the Briefing Assistant in Teams). The draft PDF is attached.</p><p>@{if(empty(parameters('brn_StudioUrl (brn_StudioUrl)')), '', concat('<a href=\"', parameters('brn_StudioUrl (brn_StudioUrl)'), '\">Open in Briefing Studio</a> &nbsp;|&nbsp; '))}<a href=\"@{outputs('Draft_Url')}\">Draft PDF</a> &nbsp;|&nbsp; <a href=\"@{parameters('brn_AppBaseUrl (brn_AppBaseUrl)')}&pagetype=entityrecord&etn=brn_request&id=@{triggerOutputs()?['body/brn_requestid']}\">Open in Briefing Notes Hub</a></p><p style=\"color:#737373;font-size:9pt\">Sent by the Briefing Note Generator. The note is an AI-assisted draft reviewed by staff.</p>",
              "emailMessage/Importance": "Normal",
              "emailMessage/Cc": "@body('Get_Request')?['brn_requesteremail']",
              "emailMessage/Attachments": [
               {
                "Name": "@{concat(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(body('Get_Request')?['brn_requestnumber'], '/', '-'), '\\', '-'), ':', '-'), '*', '-'), '?', '-'), '\"', '-'), '<', '-'), '>', '-'), '|', '-'), '#', '-'), '%', '-'), '&', '-'), ' - DRAFT v', string(body('Get_Request')?['brn_draftversion']), '.pdf')}",
                "ContentBytes": "@body('Draft_Pdf')"
               }
              ]
             }
            },
            "runAfter": {}
           },
           "Teams_Reviewer": {
            "type": "OpenApiConnection",
            "inputs": {
             "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
              "connectionName": "shared_teams",
              "operationId": "PostMessageToConversation"
             },
             "parameters": {
              "poster": "Flow bot",
              "location": "Chat with Flow bot",
              "body/recipient": "@coalesce(body('Get_Request')?['brn_revieweremail'], body('Get_Profile')?['brn_defaultrevieweremail'], body('Get_Request')?['brn_requesteremail'])",
              "body/messageBody": "<p><b>📝 @{body('Get_Request')?['brn_requestnumber']}: draft ready for your review</b></p><p><b>@{replace(replace(replace(coalesce(body('Get_Request')?['brn_notetitle'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</b></p><p>@{substring(replace(replace(replace(concat(decodeUriComponent('%0A'), replace(replace(replace(coalesce(body('Get_Request')?['brn_keymessage'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')), decodeUriComponent('%0A'), '<br>'), '<br>- ', '<br>&bull;&nbsp;'), '<br><br>&bull;', '<br>&bull;'), 4)}</p><p>@{if(empty(parameters('brn_StudioUrl (brn_StudioUrl)')), '', concat('<a href=\"', parameters('brn_StudioUrl (brn_StudioUrl)'), '\">Open in Briefing Studio</a> &nbsp;|&nbsp; '))}<a href=\"@{outputs('Draft_Url')}\">Draft PDF</a> &nbsp;|&nbsp; <a href=\"@{parameters('brn_AppBaseUrl (brn_AppBaseUrl)')}&pagetype=entityrecord&etn=brn_request&id=@{triggerOutputs()?['body/brn_requestid']}\">Open in Briefing Notes Hub</a></p>"
             }
            },
            "runAfter": {
             "Email_Reviewer": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
             ]
            }
           },
           "Teams_Requester": {
            "type": "OpenApiConnection",
