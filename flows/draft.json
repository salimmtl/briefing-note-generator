         "Draft_Url": {
          "type": "Compose",
          "inputs": "@replace(concat(body('Get_Profile')?['brn_sharepointsiteurl'], '/', body('Get_Profile')?['brn_sharepointlibrary'], '/', concat(body('Get_Profile')?['brn_sharepointrootfolder'], '/', replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(body('Get_Request')?['brn_requestnumber'], '/', '-'), '\\', '-'), ':', '-'), '*', '-'), '?', '-'), '\"', '-'), '<', '-'), '>', '-'), '|', '-'), '#', '-'), '%', '-'), '&', '-'), '/Drafts'), '/', concat(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(body('Get_Request')?['brn_requestnumber'], '/', '-'), '\\', '-'), ':', '-'), '*', '-'), '?', '-'), '\"', '-'), '<', '-'), '>', '-'), '|', '-'), '#', '-'), '%', '-'), '&', '-'), ' - DRAFT v', string(body('Get_Request')?['brn_draftversion']), '.pdf')), ' ', '%20')",
          "runAfter": {
