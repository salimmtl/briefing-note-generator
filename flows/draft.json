            "item/brn_RequestId@odata.bind": "/brn_requests(@{triggerOutputs()?['body/brn_requestid']})",
            "item/brn_actor": 743800002,
            "item/brn_activitytype": 743800004,
            "item/brn_startedon": "@variables('startTime')",
            "item/brn_workflowrun": "@{workflow()?['run']?['name']}",
            "item/brn_details": "@{substring(coalesce(body('Run_Briefing_Note_Writer')?['structuredOutput']?['summary'], ''), 0, min(3900, length(coalesce(body('Run_Briefing_Note_Writer')?['structuredOutput']?['summary'], ''))))}",
            "item/brn_completedon": "@utcNow()",
            "item/brn_durationseconds": "@div(sub(ticks(utcNow()), ticks(variables('startTime'))), 10000000)"
           }
          },
          "runAfter": {
           "Notify_Review": [
            "Succeeded",
            "Failed",
            "Skipped",
            "TimedOut"
           ]
          }
         }
        }
       }
      }
     },
     "runAfter": {
      "Init_Start_Time": [
       "Succeeded"
      ]
     }
