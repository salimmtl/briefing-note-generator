         "item/brn_status": 743800010,
         "item/brn_lasterror": "@{substring(concat(first(body('Failed_Actions'))?['name'], ': ', string(coalesce(first(body('Failed_Actions'))?['outputs']?['body']?['error'], first(body('Failed_Actions'))?['error'], first(body('Failed_Actions'))?['outputs']?['body'], 'unknown error'))), 0, min(3900, length(concat(first(body('Failed_Actions'))?['name'], ': ', string(coalesce(first(body('Failed_Actions'))?['outputs']?['body']?['error'], first(body('Failed_Actions'))?['error'], first(body('Failed_Actions'))?['outputs']?['body'], 'unknown error'))))))}"
        }
       },
       "runAfter": {
