              "body/recipient": "@body('Get_Request')?['brn_requesteremail']",
              "body/messageBody": "<p><b>✅ @{body('Get_Request')?['brn_requestnumber']}: your draft is ready</b> and was sent to @{coalesce(body('Get_Request')?['brn_revieweremail'], body('Get_Profile')?['brn_defaultrevieweremail'], body('Get_Request')?['brn_requesteremail'])} for review.</p><p><b>@{replace(replace(replace(coalesce(body('Get_Request')?['brn_notetitle'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</b></p><p>@{if(empty(parameters('brn_StudioUrl (brn_StudioUrl)')), '', concat('<a href=\"', parameters('brn_StudioUrl (brn_StudioUrl)'), '\">Open in Briefing Studio</a> &nbsp;|&nbsp; '))}<a href=\"@{outputs('Draft_Url')}\">Draft PDF</a> &nbsp;|&nbsp; <a href=\"@{parameters('brn_AppBaseUrl (brn_AppBaseUrl)')}&pagetype=entityrecord&etn=brn_request&id=@{triggerOutputs()?['body/brn_requestid']}\">Open in Briefing Notes Hub</a></p>"
