         "item/brn_actor": 743800003,
         "item/brn_activitytype": 743800008,
         "item/brn_startedon": "@variables('startTime')",
         "item/brn_workflowrun": "@{workflow()?['run']?['name']}",
         "item/brn_details": "@{substring(concat(first(body('Failed_Actions'))?['name'], ': ', string(coalesce(first(body('Failed_Actions'))?['outputs']?['body']?['error'], first(body('Failed_Actions'))?['error'], first(body('Failed_Actions'))?['outputs']?['body'], 'unknown error'))), 0, min(3900, length(concat(first(body('Failed_Actions'))?['name'], ': ', string(coalesce(first(body('Failed_Actions'))?['outputs']?['body']?['error'], first(body('Failed_Actions'))?['error'], first(body('Failed_Actions'))?['outputs']?['body'], 'unknown error'))))))}",
         "item/brn_completedon": "@utcNow()",
         "item/brn_durationseconds": "@div(sub(ticks(utcNow()), ticks(variables('startTime'))), 10000000)"
        }
